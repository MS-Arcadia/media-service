# Arcadia media service — local configuration.
#
#   cp .env.example .env
#
# Development defaults, not secrets. Every credential here says change-me on purpose.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
HTTP_PORT=8084

DATABASE_URL=postgresql://media_user:media_pass@localhost:5432/arcadia_media

# Must match whatever the Auth service signs with. Minimum 32 characters.
JWT_SECRET=local-development-jwt-secret-change-me-please

# Verified, not optional — these match what the Go wallet and payment services require, so a
# token accepted here is accepted everywhere. Set either to empty to stop checking it, which
# should be a deliberate decision rather than an accident.
JWT_ISSUER=arcadia-auth
JWT_AUDIENCE=arcadia

# Signs download URLs. A SEPARATE secret from JWT_SECRET on purpose: a download token is not
# an identity token, and one leaking must not compromise the other. Boot fails if they match.
DOWNLOAD_SECRET=local-development-download-secret-change-me
DOWNLOAD_TTL_SECONDS=900

# Where the bytes go. A directory, not a MinIO bucket — see
# app/adapters/outbound/filesystem.py for the trade-off.
STORAGE_ROOT=./.local-store

# Must be reachable by whoever follows the URLs this service hands out — a browser, not the
# internal Docker network.
PUBLIC_BASE_URL=http://localhost:8084

KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:29092
